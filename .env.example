# Copy to .env (git-ignored) and adjust. Settings.from_env() reads it automatically, so
# `uv run python tasks.py serve` / `chat` / `eval` need no environment variables set by hand,
# in any shell. A non-empty variable set in the real environment wins over this file.

# Claude API key: the agent. Without it the API still runs (no replies) and chat/eval refuse
# to start. Never commit a real key.
ANTHROPIC_API_KEY=
COMPASS_MODEL=claude-sonnet-5-5
# Max model->tool round trips per employee message.
COMPASS_MAX_TOOL_ROUNDS=8
# Session safety limit: after this many agent turns, or this many input tokens (uncached + cache
# read + cache write) in one session, the server replies with a fixed message and stops calling
# the model for that session; the UI offers a new conversation.
COMPASS_MAX_SESSION_TURNS=40
COMPASS_MAX_SESSION_INPUT_TOKENS=2000000
# Live mode: all model calls on this server per UTC day, USD; then a fixed reply until tomorrow.
COMPASS_DAILY_SPEND_CAP_USD=5
# POST /api/sessions/{id}/messages per client IP per minute (429 beyond it).
COMPASS_MESSAGE_RATE_PER_MINUTE=20
# anthropic (default) or scripted: demo mode, a scripted model with two scenarios (walkthrough,
# E-001). No key, no network; tools, the number guard and tickets still run for real.
COMPASS_LLM=anthropic

# 1 = enable POST /api/sessions/{id}/tools/{name} (dev / demo only). Leave 0 in production.
COMPASS_DEV_TOOLS=1

# Shared bearer tokens. Unset or empty = the endpoints answer 503 "not configured", the server
# warns at startup, and /rep and the judges-mode dialog say the token is not set.
# Live mode (COMPASS_LLM=anthropic) refuses to start while a token is empty, rep-demo /
# admin-demo, or one of the placeholders below. Generate real ones in PowerShell:
#   [guid]::NewGuid().ToString()
COMPASS_REP_TOKEN=rep-demo-change-me
COMPASS_ADMIN_TOKEN=admin-demo-change-me

# Optional overrides (defaults shown).
# COMPASS_APP_DB=data/app.db
# Demo mode (COMPASS_LLM=scripted) uses its own database and never app.db;
# `uv run python tasks.py demo-reset` wipes it.
# COMPASS_DEMO_DB=data/demo.db
# COMPASS_RULES=data/rules.yaml
# The built UI (`tasks.py build-web`), served at / when web/dist/index.html exists.
# COMPASS_WEB_DIST=web/dist
# COMPASS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
