# Copy to .env (git-ignored) and adjust. Settings.from_env() reads it automatically, so
# `uv run python tasks.py serve` needs no environment variables set by hand, in any shell.
# A variable set in the real environment wins over this file.

# Claude API key (Day 3: the agent).
ANTHROPIC_API_KEY=

# 1 = enable POST /api/sessions/{id}/tools/{name} (dev / demo only). Leave 0 in production.
COMPASS_DEV_TOOLS=1

# Shared bearer tokens. Unset or empty = the endpoints answer 503 "not configured".
# Demo placeholders: replace with long random values for anything but a local demo.
COMPASS_REP_TOKEN=demo-rep-token-change-me
COMPASS_ADMIN_TOKEN=demo-admin-token-change-me

# Optional overrides (defaults shown).
# COMPASS_APP_DB=data/app.db
# COMPASS_RULES=data/rules.yaml
# COMPASS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
