# Generated databases (rebuilt by `python tasks.py data`) and the app's session store
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.tmp

# Secrets: .env and any local variant; only the template is committed
.env
.env.*
!.env.example

# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Web UI (also in web/.gitignore): dependencies, builds, Playwright artifacts
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/blob-report/

# Backup video: the webm files are committed (under 25 MB); mp4 conversions are local only
docs/video/*.mp4
