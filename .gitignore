# Generated databases (rebuilt by `tasks.py data` into backend/data/) and the app's session store
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.tmp

# Secrets: .env and any local variant; only the template is committed
.env
.env.*
!.env.example

# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Web UI (also in frontend/.gitignore): dependencies, builds, Playwright artifacts
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Backup video: the webm files are committed (under 25 MB); mp4 conversions are local only
docs/video/*.mp4
