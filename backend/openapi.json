{
  "components": {
    "schemas": {
      "CurrentCarPick": {
        "additionalProperties": false,
        "properties": {
          "car_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Car Id"
          },
          "choice": {
            "enum": [
              "car",
              "check_year",
              "no_car",
              "not_in_list"
            ],
            "title": "Choice",
            "type": "string"
          }
        },
        "required": [
          "choice"
        ],
        "title": "CurrentCarPick",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageAccepted": {
        "properties": {
          "message_seq": {
            "title": "Message Seq",
            "type": "integer"
          }
        },
        "required": [
          "message_seq"
        ],
        "title": "MessageAccepted",
        "type": "object"
      },
      "QuestionAnswerBody": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "status": {
            "default": "answered",
            "description": "needs_checking: the question stays pending (with the note)",
            "enum": [
              "answered",
              "needs_checking"
            ],
            "title": "Status",
            "type": "string"
          },
          "value": {
            "description": "amount: whole ILS; choice: an option's value; yes_no: yes / no; text: the answer. None with status needs_checking",
            "title": "Value"
          }
        },
        "title": "QuestionAnswerBody",
        "type": "object"
      },
      "SessionCreated": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "SessionCreated",
        "type": "object"
      },
      "TicketAnswer": {
        "additionalProperties": false,
        "properties": {
          "answer_text": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer Text"
          },
          "answers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/QuestionAnswerBody"
            },
            "description": "Question id (the ticket view's questions[].id) -> its answer in this part",
            "title": "Answers",
            "type": "object"
          },
          "effective_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When a participation amount takes effect (participation fields only)",
            "title": "Effective From"
          },
          "partial": {
            "default": false,
            "description": "Answer only the fields given in `values`; the others stay pending and the ticket stays open (the answer that fills the last one closes it). Default: the fields left out become unknown and the ticket closes.",
            "title": "Partial",
            "type": "boolean"
          },
          "quick_answer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quick Answer Id"
          },
          "values": {
            "additionalProperties": true,
            "description": "Tool field -> value",
            "title": "Values",
            "type": "object"
          }
        },
        "title": "TicketAnswer",
        "type": "object"
      },
      "UserMessage": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "UserMessage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "AdminToken": {
        "scheme": "bearer",
        "type": "http"
      },
      "RepToken": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Company-car net-salary assistant: sessions, tools, tickets, live events.",
    "title": "Compass API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/reload-rules": {
      "post": {
        "description": "Re-read and validate rules.yaml live. Invalid -> 422; the previous rules stay.",
        "operationId": "reload_rules_api_admin_reload_rules_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "AdminToken": []
          }
        ],
        "summary": "Reload Rules",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/stats": {
      "get": {
        "description": "Judges mode's stats tiles, from committed files (evals/report.md, evals/spend.jsonl,\ntests/counts.json). A part whose file is missing or unreadable is null.",
        "operationId": "admin_stats_api_admin_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Admin Stats Api Admin Stats Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "AdminToken": []
          }
        ],
        "summary": "Admin Stats",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/catalog": {
      "get": {
        "operationId": "get_catalog_api_catalog_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get Catalog Api Catalog Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Catalog",
        "tags": [
          "data"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/occupations": {
      "get": {
        "operationId": "get_occupations_api_occupations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get Occupations Api Occupations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Occupations",
        "tags": [
          "data"
        ]
      }
    },
    "/api/rules": {
      "get": {
        "operationId": "get_rules_api_rules_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Rules Api Rules Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Rules",
        "tags": [
          "data"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "create_session_api_sessions_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "description": "Snapshot: everything the UI needs to restore after a refresh. Without the admin\nbearer, messages are the employee's and the shown replies' text only.",
        "operationId": "get_session_api_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Session Api Sessions  Session Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AdminToken": []
          }
        ],
        "summary": "Get Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}/current-car": {
      "post": {
        "description": "The employee's choice in the picker: a catalog car, 'no car', 'not in the list' or\n'another year, a representative checks'.",
        "operationId": "pick_car_api_sessions__session_id__current_car_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CurrentCarPick"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such session"
          },
          "409": {
            "description": "Today's car is known already, or a representative was asked"
          },
          "422": {
            "description": "An unknown car, or a choice that does not fit"
          }
        },
        "summary": "Pick Car",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}/events": {
      "get": {
        "description": "Server-sent events. Replays everything after Last-Event-ID (or `after`), then\nstreams live; a comment heartbeat keeps the connection open. Without the admin bearer\neach payload is redacted to its public part (compass/api/redact.py).",
        "operationId": "stream_events_api_sessions__session_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "description": "Replay after this seq (no header)",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Replay after this seq (no header)",
              "title": "After"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AdminToken": []
          }
        ],
        "summary": "Stream Events",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}/messages": {
      "post": {
        "description": "Store the message and hand it to the agent. At most COMPASS_MESSAGE_RATE_PER_MINUTE\nper client IP (429 with Retry-After beyond that).",
        "operationId": "post_message_api_sessions__session_id__messages_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserMessage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many messages from this IP (Retry-After)"
          }
        },
        "summary": "Post Message",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}/tools/{name}": {
      "post": {
        "description": "Run a tool directly (dev / demo only: COMPASS_DEV_TOOLS=1, otherwise 404).",
        "operationId": "run_tool_api_sessions__session_id__tools__name__post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Tool Api Sessions  Session Id  Tools  Name  Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Tool",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/tickets": {
      "get": {
        "description": "The representative inbox. Each ticket has a display-ready `view` (title, the fields\nwith their catalog default, the employee's latest comparison).",
        "operationId": "list_tickets_api_tickets_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "open",
                    "answered"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Tickets Api Tickets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "RepToken": []
          }
        ],
        "summary": "List Tickets",
        "tags": [
          "representative"
        ]
      }
    },
    "/api/tickets/events": {
      "get": {
        "description": "Server-sent events for the inbox: a `tickets` event with every open ticket (as in\nGET /tickets?status=open) on connect and whenever the list or a ticket's comparison\nchanges. Each event is the whole list, so a reconnect needs no replay.",
        "operationId": "stream_tickets_api_tickets_events_get",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "RepToken": []
          }
        ],
        "summary": "Stream Tickets",
        "tags": [
          "representative"
        ]
      }
    },
    "/api/tickets/{ticket_id}/answer": {
      "post": {
        "description": "Answer a ticket: per question (`answers`) or per bound field (`values`). Bound\nquestions fill their field (source representative); free questions' answers go to the\nagent as data. Resume the employee's session and tell the agent. Unless `partial`,\nquestions left without an answer become unknown (answered, but not with a value).",
        "operationId": "answer_ticket_api_tickets__ticket_id__answer_post",
        "parameters": [
          {
            "in": "path",
            "name": "ticket_id",
            "required": true,
            "schema": {
              "title": "Ticket Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketAnswer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Answer Ticket Api Tickets  Ticket Id  Answer Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "RepToken": []
          }
        ],
        "summary": "Answer Ticket",
        "tags": [
          "representative"
        ]
      }
    }
  }
}
