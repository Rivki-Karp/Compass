# Force LF everywhere so generated files are byte-identical on Windows and macOS.
* text=auto eol=lf
*.xlsx binary
*.pdf binary
*.db binary
*.webm binary
*.mp4 binary
# Raw challenge files are stored byte-for-byte (several use CRLF); backend/raw/README.md lists
# their SHA-256 and backend/tests/test_raw_files.py checks them.
backend/raw/** -text
backend/raw/README.md text eol=lf
