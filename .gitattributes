# Force LF everywhere so generated files are byte-identical on Windows and macOS.
* text=auto eol=lf
*.xlsx binary
*.pdf binary
*.db binary
*.webm binary
*.mp4 binary
# Raw challenge files are stored byte-for-byte (several use CRLF); raw/README.md lists their
# SHA-256 and tests/test_raw_files.py checks them.
raw/** -text
raw/README.md text eol=lf
